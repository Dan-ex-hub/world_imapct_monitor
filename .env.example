# ImpactGlobe — environment variables
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local        (macOS/Linux)
#   copy .env.example .env.local      (Windows)
#
# .env.local is gitignored — never commit real secrets.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then run supabase-schema.sql
# and update-env-cache-schema.sql (SQL Editor) to create the required tables.
# Project Settings → API for these three values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI news generation (at least one recommended) ─────────────────────────────
# Used by /api/news/gemini to generate/analyze geopolitical events.
# Groq is tried first (faster, generous free tier), Gemini is the fallback.
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/app/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Forex data (optional) ──────────────────────────────────────────────────────
# Powers the Markets tab (live pairs + sparklines). Without it, ForexPanel
# shows an empty state. Free tier: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# ── News aggregation (optional) ────────────────────────────────────────────────
# Alternative/supplementary news source used by /api/news/refresh.
# Free tier (200 req/day): https://newsdata.io/register
NEWSDATA_API_KEY=

# ── Cron & admin auth (required for production) ───────────────────────────────
# Protects /api/cron/* and admin-triggered routes (forex init, cache clear).
# Any long random string works. In development these routes are open.
CRON_SECRET=
ADMIN_SECRET=

# ── App URL (required in production) ───────────────────────────────────────────
# Used by cron/heartbeat to call other routes on the same deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Reserved / not currently wired up ──────────────────────────────────────────
# Present for forward-compatibility with public/sw.js (push notifications) and
# an alternate weather source. No current code path reads these — safe to leave
# blank unless you're building on top of them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
WEATHERAPI_KEY=
